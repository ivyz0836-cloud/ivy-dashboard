<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		必须与 App target 的 App Group 完全一致，
		小组件才有权限读取共享容器里的 ivy_snapshot.json。
		占位值：group.com.ivy.workbench
	-->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.ivy.workbench</string>
	</array>
</dict>
</plist>
